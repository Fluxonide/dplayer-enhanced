{
    "name": "dplayer-enhanced",
    "version": "2.0.0-beta.2",
    "description": "Enhanced DPlayer with comprehensive keyboard shortcuts - forked from DIYgod/DPlayer",
    "main": "dist/DPlayer.min.js",
    "module": "dist/DPlayer.esm.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/DPlayer.esm.js",
            "require": "./dist/DPlayer.min.js",
            "types": "./dist/types/index.d.ts"
        },
        "./dist/DPlayer.css": "./dist/DPlayer.css"
    },
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "start": "npm run dev",
        "build": "rollup -c rollup.config.mjs",
        "dev": "rollup -c rollup.config.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "",
        "format": "prettier \"**/*.{ts,js,json,md}\" --write",
        "format:check": "prettier \"**/*.{ts,js,json,md}\" --check",
        "docs:dev": "vuepress dev docs",
        "docs:build": "vuepress build docs",
        "prepare": "node -e \"try{require('husky').install()}catch(e){if(e.code!=='MODULE_NOT_FOUND')throw e}\"",
        "prepublishOnly": "npm run build && npm run typecheck"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "files": [
        "dist"
    ],
    "repository": {
        "url": "git+https://github.com/Fluxonide/dplayer-enhanced.git",
        "type": "git"
    },
    "keywords": [
        "player",
        "danmaku",
        "video",
        "html5"
    ],
    "author": "Fluxonide",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Fluxonide/dplayer-enhanced/issues"
    },
    "homepage": "https://github.com/Fluxonide/dplayer-enhanced#readme",
    "devDependencies": {
        "@rollup/plugin-commonjs": "^26.0.1",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.7",
        "@rollup/plugin-typescript": "^11.1.6",
        "@rollup/plugin-url": "^8.0.2",
        "@types/node": "^20.5.0",
        "@vuepress/plugin-pwa": "1.9.9",
        "autoprefixer": "^10.4.15",
        "cssnano": "^6.0.1",
        "husky": "^8.0.3",
        "less": "^4.2.0",
        "lint-staged": "^17.0.0",
        "postcss": "^8.4.27",
        "postcss-preset-env": "^9.1.1",
        "prettier": "^3.0.1",
        "pretty-quick": "^4.0.0",
        "rollup": "^4.18.0",
        "rollup-plugin-livereload": "^2.0.5",
        "rollup-plugin-postcss": "^4.0.2",
        "rollup-plugin-serve": "^2.0.2",
        "rollup-plugin-string": "^3.0.0",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "axios": "^1.18.1",
        "balloon-css": "^1.0.3",
        "promise-polyfill": "8.3.0"
    },
    "overrides": {
        "braces": "^3.0.3",
        "micromatch": "^4.0.8",
        "cross-spawn": "^7.0.6",
        "highlight.js": "^11.9.0",
        "http-proxy-middleware": "^3.0.0"
    }
}
